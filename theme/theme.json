    "shadow": {
      "presets": [
        {
          "name": "Tarjeta",
          "shadow": "0 2px 6px rgba(13, 13, 13, 0.14)",
          "slug": "vicunav-shadow-card"
        },
        {
          "name": "Tarjeta elevada",
          "shadow": "0 8px 20px rgba(13, 13, 13, 0.18)",
          "slug": "vicunav-shadow-card-hover"
        },
        {
          "name": "Panel",
          "shadow": "0 12px 28px rgba(13, 13, 13, 0.22)",
          "slug": "vicunav-shadow-panel"
        },
        {
          "name": "Modal",
          "shadow": "0 20px 48px rgba(13, 13, 13, 0.28)",
          "slug": "vicunav-shadow-modal"
        },
        {
          "name": "Aviso",
          "shadow": "0 8px 20px rgba(13, 13, 13, 0.24)",
          "slug": "vicunav-shadow-toast"
        }
      ],
      "defaultPresets": false
    },
    "layout": {
      "contentSize": "42rem",
      "wideSize": "77.5rem"
    },
    "custom": {
      "vicunav": {
        "border": {
          "width": {
            "thin": "1px",
            "regular": "2px"
          }
        },
        "breakpoint": {
          "small": "480px",
          "medium": "768px",
          "large": "1024px",
          "wide": "1440px"
        },
        "container": {
          "max": "1240px"
        },
        "motion": {
          "duration": {
            "fast": "120ms",
            "base": "200ms",
            "slow": "320ms"
          }
        },
        "opacity": {
          "subtle": "0.12",
          "muted": "0.5",
          "strong": "0.75"
        },
        "radius": {
          "none": "0px",
          "sm": "4px",
          "md": "8px",
          "lg": "16px",
          "pill": "999px"
        },
        "surface": {
          "overlayLight": "rgba(250, 235, 215, 0.72)",
          "overlayDark": "rgba(13, 13, 13, 0.62)"
        },
        "text": {
          "mutedOpacity": "0.62"
        },
        "section": {
          "paddingBlock": "clamp(64px, 10vw, 140px)",
          "paddingInline": "clamp(24px, 5vw, 96px)"
        }
      }
    },
    "appearanceTools": true
  },
  "styles": {
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--vicunav-space-lg)"
    },
    "color": {
      "background": "var(--wp--preset--color--vicunav-neutral-100)",
      "text": "var(--wp--preset--color--vicunav-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--vicunav-body)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--vicunav-primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--vicunav-secondary)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--vicunav-primary)",
          "text": "var(--wp--preset--color--vicunav-neutral-100)"
        },
        "border": {
          "radius": "var(--wp--custom--vicunav--radius--pill)"
        },
        "css": "&:hover { opacity: 0.72; }"
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
          "fontWeight": "800",
          "textTransform": "uppercase"
        },
        "css": "transform: scaleY(1.22); transform-origin: bottom;"
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
          "fontWeight": "800",
          "textTransform": "uppercase"
        },
        "css": "transform: scaleY(1.22); transform-origin: bottom;"
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
          "fontWeight": "800",
          "textTransform": "uppercase"
        },
        "css": "transform: scaleY(1.22); transform-origin: bottom;"
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
          "fontWeight": "800",
          "textTransform": "uppercase"
        },
        "css": "transform: scaleY(1.22); transform-origin: bottom;"
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--vicunav-heading)",
          "fontWeight": "800",
          "textTransform": "uppercase"
        },
        "css": "transform: scaleY(1.22); transform-origin: bottom;"
